{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ALLOW_PRODUCTION_MIGRATION",
        "BETTER_AUTH_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "ENCRYPTION_KEY",
        "GITHUB_CLIENT_SECRET",
        "KV_REST_API_READ_ONLY_TOKEN",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "KV_URL",
        "NEXT_PUBLIC_AUTH_PROVIDERS",
        "NEXT_PUBLIC_GITHUB_CLIENT_ID",
        "NEXT_PUBLIC_VERCEL_APP_CLIENT_ID",
        "OPEN_AGENTS_ENABLE_TEST_AUTH",
        "POSTGRES_URL",
        "PRODUCTION_DB_HOST",
        "REDIS_URL",
        "VERCEL_APP_CLIENT_SECRET",
        "VERCEL_ENV"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "outputs": []
    }
  }
}
