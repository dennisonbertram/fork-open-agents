{
  "name": "open-agents",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "ai": "^6.0.165",
      "@ai-sdk/anthropic": "^3.0.70",
      "@ai-sdk/openai": "^3.0.53",
      "@ai-sdk/openai-compatible": "^2.0.51",
      "@ai-sdk/react": "^3.0.167",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "web": "cd apps/web/ && bun run dev",
    "dev": "turbo dev",
    "build": "turbo build",
    "sandbox:snapshot-base": "bun run scripts/vercel-refresh-base-snapshot.ts",
    "proof:isolated-worker": "bun run apps/web/scripts/isolated-worker-live-proof.ts",
    "typecheck": "turbo typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "ci": "bun run check && bun run typecheck && bun run test:isolated && bun run --cwd apps/web db:check",
    "test": "bun test --isolate",
    "test:isolated": "bun run scripts/test-isolated.ts",
    "test:verbose": "bun test --reporter=junit --reporter-outfile /dev/stdout",
    "test:contract": "bun test apps/web/tests/contract",
    "test:coverage": "bun test --coverage",
    "check:migration-safety": "bun run scripts/check-migration-safety.ts",
    "check:test-touch": "bun run scripts/check-test-touch.ts",
    "hooks:install": "git config core.hooksPath .githooks && echo 'git hooks installed (core.hooksPath=.githooks)'"
  },
  "devDependencies": {
    "oxfmt": "^0.43.0",
    "oxlint": "1.57.0",
    "turbo": "^2.5.4",
    "typescript": "^5",
    "ultracite": "7.4.0"
  },
  "overrides": {
    "zod": "^4.3.6"
  },
  "packageManager": "bun@1.2.14"
}
