    "/api/sessions/{sessionId}/git/status": {
      "get": {
        "operationId": "getGitStatus",
        "summary": "Get the session's git status",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Git status (null if unavailable)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "nullable": true,
                      "type": "object",
                      "properties": {
                        "branch": {
                          "type": "string"
                        },
                        "isDetachedHead": {
                          "type": "boolean"
                        },
                        "hasUncommittedChanges": {
                          "type": "boolean"
                        },
                        "hasUnpushedCommits": {
                          "type": "boolean"
                        },
                        "stagedCount": {
                          "type": "number"
                        },
                        "unstagedCount": {
                          "type": "number"
                        },
                        "untrackedCount": {
                          "type": "number"
                        },
                        "uncommittedFiles": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "branch",
                        "isDetachedHead",
                        "hasUncommittedChanges",
                        "hasUnpushedCommits",
                        "stagedCount",
                        "unstagedCount",
                        "untrackedCount",
                        "uncommittedFiles"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
