# Minimum runtime
POSTGRES_URL=
BETTER_AUTH_SECRET=

# Vercel OAuth (required for sign-in)
# Register both production and local callbacks in the Vercel OAuth app:
#   https://YOUR_DOMAIN/api/auth/callback/vercel
#   http://localhost:3000/api/auth/callback/vercel
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub App (required for repo access, pushes, and PRs)
# Callback URL: {YOUR_ORIGIN}/api/auth/callback/github (better-auth)
# Setup URL:    {YOUR_ORIGIN}/api/github/app/callback (installation sync)
# In the GitHub App settings:
#   1. Use the GitHub App Client ID and Client Secret below
#   2. Make the app public if you want org installs to work cleanly
#   3. Store the private key either as PEM contents with escaped newlines
#      or as a base64-encoded PEM
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional integrations
ELEVENLABS_API_KEY=
# Server-side project key for Composio external tool profiles.
COMPOSIO_API_KEY=

# Redis / Vercel KV
# Required in production for rate-limited endpoints that create sessions,
# sandboxes, PRs, and other agent work. Some non-critical caches fall back to
# in-memory when unset, but production rate limiting intentionally fails closed.
REDIS_URL=
KV_URL=
RATE_LIMIT_TIMEOUT_MS=

# Optional deployment refinements
# Set to "hobby" to use lower resource defaults for constrained deployments.
# Leave unset for standard behavior.
OPEN_AGENTS_RESOURCE_PROFILE=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# Optional base snapshot for fresh sandboxes. If unset, sandboxes use Vercel's standard Sandbox runtime.
# Use a snapshot created in/accessible to your own Vercel scope.
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=

# Verified Build harness integration
HARNESS_ENABLED=false
HARNESS_BASE_URL=http://localhost:4318
HARNESS_SERVICE_TOKEN=
HARNESS_TENANT_ID=
HARNESS_DEFAULT_PROJECT_ID=
HARNESS_ALLOWED_DIRECT_MODE=false
HARNESS_LOG_JSON=false
HARNESS_REQUEST_TIMEOUT_MS=15000
HARNESS_SSE_REPLAY_LIMIT=100

# Optional observability export discovery rendered from the harness export plan.
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGTRACE_ENDPOINT=
LANGTRACE_API_KEY_REF=

# Background agents
# Keep disabled until the persistence, trigger, and execution paths are proven
# for your deployment.
# Audit Vercel env names with:
#   bun run --cwd apps/web background-agents:env-audit -- --environment preview --branch <branch>
BACKGROUND_AGENTS_ENABLED=false
# Optional safety gate for controlled proof or staged rollout. Comma or
# whitespace separated owner/repo entries. Unset or "*" allows all repos.
BACKGROUND_AGENTS_ALLOWED_REPOS=
# Vercel Cron sends CRON_SECRET as the Authorization bearer token. The
# background-specific secret is also accepted for manual/local invocations.
CRON_SECRET=
BACKGROUND_AGENTS_CRON_SECRET=
BACKGROUND_AGENTS_WEBHOOK_SECRET=
# (#914) The primary budget is now no-progress (git-delta) based, not a fixed
# turn count. BACKGROUND_AGENT_MAX_TURNS is an OPT-IN absolute hard ceiling —
# unset means no total-turn cap; set it only as a runaway safety fuse
# (server-clamped to 64).
# BACKGROUND_AGENT_MAX_TURNS=16
# Consecutive turns with no change to the sandbox git working tree before a
# background-agent run is stopped (#914). Default 20 is a starting value to
# tune from background_agent_events data, not a validated target.
# BACKGROUND_AGENT_MAX_STALE_TURNS=20

# Optional local proof harness for signed webhook.error delivery.
# Run with: bun run --cwd apps/web background-agents:webhook-proof
BACKGROUND_AGENT_PROOF_BASE_URL=
BACKGROUND_AGENT_PROOF_WEBHOOK_PUBLIC_ID=
BACKGROUND_AGENT_PROOF_REPO_OWNER=
BACKGROUND_AGENT_PROOF_REPO_NAME=
BACKGROUND_AGENT_PROOF_EXTERNAL_ID=
BACKGROUND_AGENT_PROOF_DUPLICATE=true

# Optional local proof harness for signed GitHub webhook delivery.
# Run with: bun run --cwd apps/web background-agents:github-webhook-proof
BACKGROUND_AGENT_GITHUB_PROOF_BASE_URL=
BACKGROUND_AGENT_GITHUB_PROOF_EVENT=pull_request
BACKGROUND_AGENT_GITHUB_PROOF_REPO_OWNER=
BACKGROUND_AGENT_GITHUB_PROOF_REPO_NAME=
BACKGROUND_AGENT_GITHUB_PROOF_ID=
BACKGROUND_AGENT_GITHUB_PROOF_DUPLICATE=true
