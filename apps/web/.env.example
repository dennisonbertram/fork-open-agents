# Minimum runtime
POSTGRES_URL=
# Local/dev test-auth cookie. NODE_ENV=development already enables it.
# Set to 1 only on the stable Dev (or a dedicated Preview) deployment.
# Never set this on Production. Even if set, VERCEL_ENV=production refuses
# test-auth — the guard fails closed on that platform value.
# OPEN_AGENTS_ENABLE_TEST_AUTH=
# Host of the PRODUCTION database. Arms the guard in lib/db/migrate.ts, which
# refuses to apply migrations to production from a non-production build. The
# guard fails OPEN when this is unset, so leaving it blank silently disables it.
PRODUCTION_DB_HOST=
# Override the production-migration refuse guard. Set to 1 only for an
# intentional production migrate from a non-production build.
# ALLOW_PRODUCTION_MIGRATION=
BETTER_AUTH_SECRET=
# Optional dedicated secret for encrypting inference-profile credentials.
# Falls back to BETTER_AUTH_SECRET when unset.
ENCRYPTION_KEY=
# Optional absolute origin for Better Auth (overrides Vercel URL inference).
# BETTER_AUTH_URL=

# Vercel OAuth (required for sign-in)
# Register both production and local callbacks in the Vercel OAuth app:
#   https://YOUR_DOMAIN/api/auth/callback/vercel
#   http://localhost:3000/api/auth/callback/vercel
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub App (required for repo access, pushes, and PRs)
# Callback URL: {YOUR_ORIGIN}/api/auth/callback/github (better-auth)
# Setup URL:    {YOUR_ORIGIN}/api/github/app/callback (installation sync)
# In the GitHub App settings:
#   1. Use the GitHub App Client ID and Client Secret below
#   2. Make the app public if you want org installs to work cleanly
#   3. Store the private key either as PEM contents with escaped newlines
#      or as a base64-encoded PEM
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional integrations
ELEVENLABS_API_KEY=
# Server-side project key for Composio external tool profiles.
COMPOSIO_API_KEY=

# Redis / Vercel KV
# Required in production for rate-limited endpoints that create sessions,
# sandboxes, PRs, and other agent work. Some non-critical caches fall back to
# in-memory when unset, but production rate limiting intentionally fails closed.
REDIS_URL=
KV_URL=
RATE_LIMIT_TIMEOUT_MS=

# Optional deployment refinements
# Set to "hobby" to use lower resource defaults for constrained deployments.
# Leave unset for standard behavior.
OPEN_AGENTS_RESOURCE_PROFILE=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# Optional base snapshot for fresh sandboxes. If unset, sandboxes use Vercel's standard Sandbox runtime.
# Use a snapshot created in/accessible to your own Vercel scope.
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=
# Sandbox lifetime overrides (milliseconds). Unset uses package defaults.
# SANDBOX_TIMEOUT_MS=
# SANDBOX_INACTIVITY_TIMEOUT_MS=
# SANDBOX_SNAPSHOT_EXPIRATION_MS=
# Background-agent sandbox overrides (milliseconds / vCPU count).
# BACKGROUND_AGENT_SANDBOX_TIMEOUT_MS=
# BACKGROUND_AGENT_SANDBOX_VCPUS=

# Optional public app origin used when building absolute links outside Vercel.
# NEXT_PUBLIC_APP_URL=
# Opt-in browser SSE for background-run detail pages (default off).
# NEXT_PUBLIC_ENABLE_BACKGROUND_RUN_SSE=false

# AI Gateway (managed models). Required when using gateway-backed chat models.
# AI_GATEWAY_API_KEY=
# Optional Vercel API token for sandbox/project readiness probes.
# VERCEL_TOKEN=

# Product surface exposure (default off)
# These server-only switches control whether experimental product entry points
# are discoverable. They do not enable the underlying runtime capabilities.
# See docs/process/product-surface-exposure.md before opting a surface in.
OPEN_AGENTS_EXPOSE_VERIFIED_BUILD=false
OPEN_AGENTS_EXPOSE_GTM=false
OPEN_AGENTS_EXPOSE_WORKFLOW_CATALOG=false

# Verified Build harness integration
# HARNESS_ENABLED makes the harness runtime available; it does not expose
# Verified Build in ordinary Sessions unless OPEN_AGENTS_EXPOSE_VERIFIED_BUILD
# is also exactly "true".
HARNESS_ENABLED=false
HARNESS_BASE_URL=http://localhost:4318
HARNESS_SERVICE_TOKEN=
HARNESS_TENANT_ID=
HARNESS_DEFAULT_PROJECT_ID=
HARNESS_ALLOWED_DIRECT_MODE=false
HARNESS_LOG_JSON=false
HARNESS_REQUEST_TIMEOUT_MS=15000
HARNESS_SSE_REPLAY_LIMIT=100

# Optional observability export discovery rendered from the harness export plan.
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGTRACE_ENDPOINT=
LANGTRACE_API_KEY_REF=

# Background agents
# Keep disabled until the persistence, trigger, and execution paths are proven
# for your deployment.
# Audit Vercel env names with:
#   bun run --cwd apps/web background-agents:env-audit -- --environment preview --branch <branch>
BACKGROUND_AGENTS_ENABLED=false
# Required safety gate whenever background agents are enabled. Comma or
# whitespace separated owner/repo entries. Missing, blank, malformed, or mixed
# wildcard/list values deny all dispatch. Exact "*" deliberately allows all.
BACKGROUND_AGENTS_ALLOWED_REPOS=
# Vercel Cron sends CRON_SECRET as the Authorization bearer token. The
# background-specific secret is also accepted for manual/local invocations.
CRON_SECRET=
BACKGROUND_AGENTS_CRON_SECRET=
BACKGROUND_AGENTS_WEBHOOK_SECRET=
# (#914) The primary budget is now no-progress (git-delta) based, not a fixed
# turn count. BACKGROUND_AGENT_MAX_TURNS is an OPT-IN absolute hard ceiling —
# unset means no total-turn cap; set it only as a runaway safety fuse
# (server-clamped to 64).
# BACKGROUND_AGENT_MAX_TURNS=16
# Consecutive turns with no change to the sandbox git working tree before a
# background-agent run is stopped (#914). Default 20 is a starting value to
# tune from background_agent_events data, not a validated target.
# BACKGROUND_AGENT_MAX_STALE_TURNS=20
# Consecutive identical (or short-cycling) whole-turn tool-call signatures
# before a background-agent run is flagged as stalled (#915) — an
# independent second signal from the git-delta budget above. Default 6 is a
# starting value to tune from background_agent_events data, not a validated
# target.
# BACKGROUND_AGENT_REPETITION_THRESHOLD=6
# Absolute hard ceiling on tokens consumed by a single background-agent run.
# BACKGROUND_AGENT_MAX_RUN_TOKENS=
# After a stall signal, allow this many extra turns before finalize/stop.
# BACKGROUND_AGENT_STALL_GRACE_TURNS=
# BACKGROUND_AGENT_STALL_FINALIZE_TURNS=
# Queued/running background-agent runs older than this are swept as stale (ms).
# BACKGROUND_AGENTS_STALE_RUN_MS=

# Agent loops
# Keep disabled until AGENT_LOOPS_ALLOWED_REPOS contains every repository that
# may run unattended work. Missing, blank, malformed, or mixed wildcard/list
# values deny all dispatch. Exact "*" deliberately allows all repositories.
AGENT_LOOPS_ENABLED=false
AGENT_LOOPS_ALLOWED_REPOS=
# Queued/running runs older than this threshold are considered stalled.
AGENT_LOOPS_STALL_MINUTES=15

# Optional local proof harness for signed webhook.error delivery.
# Run with: bun run --cwd apps/web background-agents:webhook-proof
BACKGROUND_AGENT_PROOF_BASE_URL=
BACKGROUND_AGENT_PROOF_WEBHOOK_PUBLIC_ID=
BACKGROUND_AGENT_PROOF_REPO_OWNER=
BACKGROUND_AGENT_PROOF_REPO_NAME=
BACKGROUND_AGENT_PROOF_EXTERNAL_ID=
BACKGROUND_AGENT_PROOF_DUPLICATE=true

# Optional local proof harness for signed GitHub webhook delivery.
# Run with: bun run --cwd apps/web background-agents:github-webhook-proof
BACKGROUND_AGENT_GITHUB_PROOF_BASE_URL=
BACKGROUND_AGENT_GITHUB_PROOF_EVENT=pull_request
BACKGROUND_AGENT_GITHUB_PROOF_REPO_OWNER=
BACKGROUND_AGENT_GITHUB_PROOF_REPO_NAME=
BACKGROUND_AGENT_GITHUB_PROOF_ID=
BACKGROUND_AGENT_GITHUB_PROOF_DUPLICATE=true

# Chat / headless run budgets (optional overrides; unset uses code defaults)
# CHAT_MAX_LENGTH_CONTINUATIONS=
# HEADLESS_RUN_MAX_STALE_STEPS=
# HEADLESS_RUN_MAX_CYCLE_PERIOD=
# HEADLESS_RUN_CYCLE_REPEATS=
# HEADLESS_RUN_NO_SANDBOX_STEP_CAP=
# HEADLESS_RUN_MAX_STEPS_WITHOUT_DIFF=
# RUN_OUTER_STEP_CEILING=

# Platform-provided on Vercel (document for self-hosters; usually leave unset)
# VERCEL=
# VERCEL_ENV=
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Ops / smoke (internal-only scripts — not required for ordinary app runtime)
# PRODUCTION_URL=
# DEPLOYMENT_URL=
# OPEN_AGENTS_TEST=
# COMPOSIO_SMOKE_TOOLKIT=
# CONTRACT_BASE_URL=
# CONTRACT_REQUIRED=
# SEED_INSTALL_LOGIN=
# BACKGROUND_AGENT_GITHUB_APP_READINESS_REPO=
# BACKGROUND_AGENT_PREFLIGHT_COOKIE=
# MCP_BASE_URL=
# MCP_TOKEN_FILE=
# MCP_VERIFY_REPO_OWNER=
# MCP_VERIFY_REPO_NAME=
# MCP_VERIFY_BASE_BRANCH=
